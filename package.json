{
  "name": "cenaiva",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@xmldom/xmldom": "^0.8.13",
    "tar": "7.5.13",
    "uuid": "^14.0.0"
  },
  "scripts": {
    "seed:users": "tsx scripts/seed-users.ts",
    "fix:profile": "tsx scripts/fix-profile.ts",
    "dev": "npm run dev --workspace=apps/web",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "mobile": "cd apps/mobile && npx expo start",
    "expo:start": "cd apps/mobile && npx expo start",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "supabase": "^2.98.2",
    "tsx": "^4.19.0"
  }
}
