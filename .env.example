# Cenaiva — environment template (safe to commit).
# Copy to .env at the repo root and fill in secrets. Never commit .env.
#
# apps/web (Vite) loads this file from the repo root via envDir — no duplicate .env under apps/web required.

# Supabase (Dashboard → Project Settings → API)
# URL is public — it appears in every client request, safe to keep.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — browser-safe, but fill from YOUR project.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — server-only. Never commit. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API (cenaiva-orchestrate edge function — required for voice booking)
OPENAI_API_KEY=

# Claude API (Edge Functions — not currently used by any active function)
ANTHROPIC_API_KEY=

# Stripe — leave empty for test mode (Cenaiva will mock payments).
# Add keys from your Stripe Dashboard to enable real charges:
#   https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_... / pk_live_...) — browser-safe by design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend (emails)
RESEND_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Vapi (voice AI — primary runtime for the Cenaiva voice pipeline)
# Get keys from: https://dashboard.vapi.ai/ → API Keys.
# - VAPI_API_KEY: private, used by scripts/sync-vapi-assistant.ts to create
#   or update the assistant. Never prefix with VITE_; never ship to the browser.
# - VITE_VAPI_PUBLIC_KEY: browser-safe, consumed by @vapi-ai/web to start calls.
# - VITE_VAPI_ASSISTANT_ID: the id printed by sync-vapi-assistant.ts after a
#   successful sync. Paste it here so the client knows which assistant to join.
# - VITE_VOICE_PROVIDER: `vapi` to use the Vapi runtime (preferred once
#   configured), `legacy` to force the hand-rolled Deepgram+11labs loop.
VAPI_API_KEY=
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_ASSISTANT_ID=
VITE_VOICE_PROVIDER=vapi

# Deepgram (speech-to-text / streaming transcriber)
# Create a key: https://console.deepgram.com/ → API Keys → Create key
# Store in Supabase Edge Function secrets (same variable name). The
# `deepgram-live-token` edge function uses it to mint short-lived browser
# tokens — the long-lived key never leaves the server.
# Do not prefix with VITE_; never ship this secret in the browser bundle.
DEEPGRAM_API_KEY=
# Toggle the noise-robust Deepgram streaming transcriber on the client.
# When "true" the assistant routes the mic through Nova-3 + browser DSP
# (echoCancellation + noiseSuppression + autoGainControl) and falls back
# to Web Speech automatically if the token / socket / worklet fails.
VITE_DEEPGRAM_STT_ENABLED=false

# ElevenLabs TTS (voice-first assistant output)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# Get voice IDs from: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
# Voice IDs are public references, not secrets — safe to keep.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Model to use for ElevenLabs TTS. `eleven_turbo_v2_5` is the lowest-latency
# option and the one the Vapi assistant sync script hard-codes into the
# voice config. Only override when evaluating a different model.
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Set to true once ELEVENLABS_API_KEY is populated in Supabase project secrets.
# When false the client skips ElevenLabs and uses browser Web Speech for TTS.
VITE_ELEVENLABS_ENABLED=false

# MapLibre style (optional — defaults to OSM demo tiles, swap for a production style URL)
VITE_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Cron (nightly Edge Functions)
CRON_SECRET=

# Sentry (error tracking)
SENTRY_DSN=

# Optional: Next.js /api/auth/repair-profile
# CENAIVA_STAFF_RESTAURANT_ID=
# CENAIVA_AUTO_STAFF_PROFILE=1
