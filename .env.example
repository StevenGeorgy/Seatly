# Cenaiva — environment template (safe to commit).
# Copy to .env at the repo root and fill in secrets. Never commit .env.
#
# apps/web (Vite) loads this file from the repo root via envDir — no duplicate .env under apps/web required.

# Supabase (Dashboard → Project Settings → API)
# URL is public — it appears in every client request, safe to keep.
# Use the project root only: https://YOUR_REF.supabase.co — never append /rest/v1 (Auth will 404).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — browser-safe, but fill from YOUR project.
# Set at least one; the app uses VITE_* first, then NEXT_PUBLIC_* (Edge Functions need this as `apikey`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — server-only. Never commit. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API (cenaiva-orchestrate edge function — required for voice booking)
OPENAI_API_KEY=

# Claude API (Edge Functions — not currently used by any active function)
ANTHROPIC_API_KEY=

# Stripe — required for the restaurant onboarding wizard (Step 8: Connect KYC + subscription)
# and for diner-side deposit / pre-order charges. See STRIPE_SETUP.md at the repo root for
# the full setup walkthrough (Connect platform enablement, webhook config, price creation).
# Dashboard: https://dashboard.stripe.com/apikeys
#
# Server-only (NEVER prefix with VITE_; goes into Supabase Edge Function secrets too):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price ID for the $200 CAD/month platform subscription (90-day trial baked in).
# Create the Price in Stripe Dashboard → Products → Add product. Server-only.
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_BOOKING_FEE_PRICE_ID
# Publishable key (pk_test_... / pk_live_...) — browser-safe by design.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Resend (emails)
RESEND_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram (speech-to-text / streaming transcriber)
# Create a key: https://console.deepgram.com/ → API Keys → Create key
# Store in Supabase Edge Function secrets (same variable name). The
# `deepgram-live-token` edge function uses it to mint short-lived browser
# tokens — the long-lived key never leaves the server.
# Do not prefix with VITE_; never ship this secret in the browser bundle.
DEEPGRAM_API_KEY=
# Toggle the Deepgram-backed transcriber on the client.
# When "true" (the default) the assistant routes the mic through Nova-3 +
# browser DSP (echoCancellation + noiseSuppression + autoGainControl). There
# is no Web Speech fallback — Cenaiva voice depends on Deepgram being
# reachable, so set this to "false" only to fully disable command voice.
VITE_DEEPGRAM_STT_ENABLED=true

# ElevenLabs TTS (voice-first assistant output)
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
# Get voice IDs from: https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=
# Voice IDs are public references, not secrets — safe to keep.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# Per-user voice picker (Step 4 — male/female timbre). Public IDs.
VITE_CENAIVA_TTS_VOICE_FEMALE_ID=8vf2Pg7VZD0Piv8GA8v9
VITE_CENAIVA_TTS_VOICE_MALE_ID=f5HLTX707KIM4SzJYzSz
# Set to true once ELEVENLABS_API_KEY is populated in Supabase project secrets.
# When false the client skips ElevenLabs and uses browser Web Speech for TTS.
VITE_ELEVENLABS_ENABLED=true

# Cenaiva voice pipeline debug — logs per-turn latency checkpoints to console
# when "true". Zero overhead when "false" (default).
VITE_CENAIVA_VOICE_DEBUG=false
# Fast-path kill switch — set to "false" to skip Stages 1–3 of the assistant
# pipeline (local collector / availability / small-prompt) and force every
# utterance straight to /cenaiva-orchestrate. Default "true".
VITE_CENAIVA_FAST_PATH=true

# MapLibre style (optional — defaults to OSM demo tiles, swap for a production style URL)
VITE_MAPLIBRE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Google Maps Platform
# Get keys from Google Cloud Console -> APIs & Services -> Credentials.
# Browser key: restrict by HTTP referrer. Used by Google Maps JavaScript API and Places UI.
VITE_GOOGLE_MAPS_API_KEY=
# Server key: server-only for Supabase Edge Functions/geocoding. Never prefix with VITE_.
GOOGLE_MAPS_SERVER_API_KEY=

# Cron (nightly Edge Functions)
CRON_SECRET=

# Sentry (error tracking — always-on, operational per ToS §19)
# Server-only DSN used by edge functions (not currently wired but reserved).
SENTRY_DSN=
# Browser DSN — apps/web boots Sentry with this when set. Leave blank to disable.
# Get from: https://sentry.io → Your project → Settings → Client Keys (DSN).
VITE_SENTRY_DSN=

# PostHog (product analytics — opt-in only, gated by cookie consent banner)
# Browser-safe project key. Leave blank to keep PostHog disabled entirely.
# Get from: https://us.posthog.com → Project settings → Project API Key.
VITE_POSTHOG_KEY=
# PostHog ingestion host. Default us.i.posthog.com; use eu.i.posthog.com for EU project.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: Next.js /api/auth/repair-profile
# CENAIVA_STAFF_RESTAURANT_ID=
# CENAIVA_AUTO_STAFF_PROFILE=1
